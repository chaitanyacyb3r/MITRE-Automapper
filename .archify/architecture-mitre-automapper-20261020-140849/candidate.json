    "cards":  [
                  {
                      "dot":  "cyan",
                      "title":  "Analysis paths",
                      "items":  [
                                    "Static tab writes the upload to a temp file, then extracts hashes, entropy, strings and PE imports before mapping signatures to techniques.",
                                    "CVE tab queries CIRCL first and falls back to NVD; the advisory text is then embedded and ranked against the MITRE corpus.",
                                    "RansomGuard tab drives a stepped in-UI event loop, surfacing modification rate and entropy spikes.",
                                    "ML tab trains a Random Forest from static features or loads the pickled model for family prediction."
                                ]
                  },
                  {
                      "dot":  "emerald",
                      "title":  "Models and data",
                      "items":  [
                                    "Sentence-BERT encodes every MITRE technique once at startup; map_text ranks the input with cosine similarity.",
                                    "The classifier reuses StaticAnalyzer to build its seven-feature vector and writes data/malware_model.pkl after training.",
                                    "MITRE STIX and the training CSV are local artifacts; the STIX file is downloaded if it is missing."
                                ]
                  },
                  {
                      "dot":  "amber",
                      "title":  "Runtime notes",
                      "items":  [
                                    "Engines are cached with st.cache_resource, so they are constructed once per Streamlit server process.",
                                    "A watchdog-based RansomGuard observer exists in src/agent_alerts.py, but the Agent Alerts tab uses its own simulation loop instead.",
                                    "The report builder reads session state and returns an in-memory PDF through a base64 download link."
                                ]
                  }
              ]
